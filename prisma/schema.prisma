generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum SituacaoVenda {
  CONCLUIDO
  CANCELADO
  INCOMPLETO
  OUTRO
}

enum SituacaoNf {
  EMITIDO
  CANCELADO
  ERRO_DE_EMISSAO
  EM_EMISSAO
  PENDENTE
  OUTRO
}

enum SituacaoConferencia {
  NF_EMITIDA
  NF_NAO_EMITIDA
  ERRO_DE_EMISSAO
  ERRO_DE_CANCELAMENTO
  NF_CANCELADA
  MULTIPLAS_NOTAS_REVISAO
  VENDA_INCOMPLETA
  OUTRO
}

enum CommType {
  INTEGRAL
  FIXED
  CALC
}

enum CurrencyMode {
  FIXED
  COL
  NONE
}

enum ImportSourceType {
  PLATFORM
  EMITTER
}

model Company {
  id        String   @id @default(cuid())
  codigo    String   @unique
  nome      String
  cnpj      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  importBatches         ImportBatch[]
  sales                 Sale[]
  invoices              Invoice[]
  checklistStates       ChecklistState[]
  valueCheckAnnotations ValueCheckAnnotation[]
  productOverrides      ProductOverride[]
}

/// Mapeamentos de plataforma são globais (compartilhados por todas as
/// empresas) — decisão do usuário, já que as mesmas plataformas de venda se
/// repetem entre clientes da contabilidade.
model PlatformConfig {
  id             String       @id @default(cuid())
  name           String
  mappings       Json
  commType       CommType
  fixedCommValue Float?
  currencyMode   CurrencyMode
  fixedCurrency  String?
  currencyCol    String?
  cleanupChars   String       @default("")
  statusMap      Json
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  importBatches ImportBatch[]
  sales         Sale[]

  @@unique([name])
}

/// Mapeamentos de emissor também são globais — ver PlatformConfig.
model EmitterConfig {
  id              String   @id @default(cuid())
  name            String
  mappings        Json
  cleanupChars    String   @default("")
  fallbackService String   @default("")
  statusMap       Json
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  importBatches ImportBatch[]
  invoices      Invoice[]

  @@unique([name])
}

model ImportBatch {
  id               String            @id @default(cuid())
  companyId        String
  company          Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  sourceType       ImportSourceType
  platformConfigId String?
  platformConfig   PlatformConfig?   @relation(fields: [platformConfigId], references: [id])
  emitterConfigId  String?
  emitterConfig    EmitterConfig?    @relation(fields: [emitterConfigId], references: [id])
  originalFilename String
  rowCount         Int
  /// Linhas originais em texto delimitado (CSV), não JSON — muito mais
  /// compacto para armazenar no banco (sem repetir nomes de campo a cada
  /// linha) mantendo a reanálise possível sem precisar reenviar o arquivo.
  rawContent       String
  competencias     String[]
  /// Competência de referência informada manualmente pelo analista no
  /// momento da importação — serve só para localizar/filtrar o arquivo na
  /// tela de Importações. NÃO é usada para nenhuma análise/checklist: a
  /// competência que realmente conta vem da nota fiscal do emissor.
  referenceCompetencia String?
  importedAt       DateTime          @default(now())
  replacedBatchId  String?

  sales    Sale[]
  invoices Invoice[]

  @@index([companyId, sourceType])
  @@index([companyId, platformConfigId])
  @@index([companyId, emitterConfigId])
}

model Sale {
  id                    String        @id @default(cuid())
  companyId             String
  company               Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  importBatchId         String
  importBatch           ImportBatch   @relation(fields: [importBatchId], references: [id], onDelete: Cascade)
  platformConfigId      String
  platformConfig        PlatformConfig @relation(fields: [platformConfigId], references: [id])
  codigoVenda           String
  codigoVendaNormalized String
  comprador             String
  plataforma            String
  produto               String        @default("Não Identificado")
  moeda                 String        @default("BRL")
  valorVenda            Float
  comissao              Float
  valorNf               Float
  situacaoVenda         SituacaoVenda
  /// Texto original da situação como veio na planilha (ex: "Aprovado"),
  /// antes do mapeamento para o enum padronizado — exibido como referência
  /// ao lado da situação já classificada, nunca usado para lógica.
  situacaoVendaOriginal String        @default("")
  competencia           String
  /// Data real da venda (dia/mês/ano), a partir da mesma coluna usada para
  /// calcular `competencia` — exibida como referência na tela de Vendas.
  /// Nula quando a coluna mapeada não pôde ser interpretada como data.
  dataVenda             DateTime?
  createdAt             DateTime      @default(now())

  @@index([companyId, competencia])
  @@index([companyId, codigoVendaNormalized])
  @@index([companyId, plataforma])
  @@index([companyId, plataforma, produto])
}

/// Per-company, per-platform, per-product commission override. When set,
/// it supersedes whatever commission the platform mapping would have
/// calculated for sales of that product — the accountant sets a real
/// coprodução/commission percentage they know is correct for that product
/// once, instead of it being recomputed generically every import.
model ProductOverride {
  id                String   @id @default(cuid())
  companyId         String
  company           Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  plataforma        String
  produto           String
  commissionPercent Float
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([companyId, plataforma, produto])
}

model Invoice {
  id                    String        @id @default(cuid())
  companyId             String
  company               Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  importBatchId         String
  importBatch           ImportBatch   @relation(fields: [importBatchId], references: [id], onDelete: Cascade)
  emitterConfigId       String
  emitterConfig         EmitterConfig @relation(fields: [emitterConfigId], references: [id])
  codigoVenda           String
  codigoVendaNormalized String
  comprador             String
  situacaoNf            SituacaoNf
  /// Texto original da situação como veio na planilha (ex: "Falha ao cancelar"),
  /// antes do mapeamento para o enum. Mesmo papel de Sale.situacaoVendaOriginal:
  /// exibir como referência e, principalmente, permitir descobrir quais valores
  /// do relatório não estão mapeados — sem isso, um valor não mapeado virava
  /// "Outro" silenciosamente e não havia como saber qual era o texto de origem.
  situacaoNfOriginal    String        @default("")
  competencia           String
  valorNf               Float
  numero                String
  tipo                  String
  codigoServico         String
  createdAt             DateTime      @default(now())

  @@index([companyId, competencia])
  @@index([companyId, codigoVendaNormalized])
}

/// Manual "I checked this value divergence and it's fine" mark. Keyed by
/// codigoVenda (not saleId) so it survives reimport/reanalyze, which
/// deletes and recreates Sale rows — the business identity of a sale is its
/// código, not the ephemeral row id.
model ValueCheckAnnotation {
  id          String   @id @default(cuid())
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  codigoVenda String
  competencia String
  createdAt   DateTime @default(now())

  @@unique([companyId, codigoVenda, competencia])
}

model ChecklistState {
  id          String   @id @default(cuid())
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  competencia String
  itemsJson   Json
  updatedAt   DateTime @updatedAt

  @@unique([companyId, competencia])
}

/// Configuração geral do Diário do Cliente — uma única linha (id = "global"),
/// aplicada à ficha de todas as empresas: quais campos do Acessórias aparecem,
/// em que ordem, e quais departamentos entram na lista de responsáveis.
model DiarioConfig {
  id            String   @id
  campos        Json
  /// Nomes dos departamentos exibidos; nulo = todos.
  departamentos Json?
  updatedAt     DateTime @updatedAt
}

/// Diário de um cliente: a lista ordenada de itens (seção, tópico, anotação,
/// dica, importante, alerta). Chaveado pelos dígitos do CNPJ/CPF — a identidade
/// da empresa no Acessórias — e não por `Company`, porque o diário cobre toda a
/// carteira e o Validador só cadastra as empresas que têm vendas para conferir.
model DiarioCliente {
  chave       String   @id
  blocos      Json
  /// Contagens desnormalizadas para os selos da lista de clientes, que assim
  /// não precisa carregar o JSON de todos os diários.
  alertas     Int      @default(0)
  totalBlocos Int      @default(0)
  updatedAt   DateTime @updatedAt
}

/// E-mails liberados a entrar no Hub.
///
/// Os **masters** não moram aqui: ficam fixos em `lib/auth/autorizados.ts`,
/// porque são a raiz de confiança — quem pode liberar os outros. Mudá-los deve
/// exigir uma alteração de código, com histórico, e não um clique de quem já
/// está dentro.
model UsuarioAutorizado {
  email     String   @id
  nome      String?
  /// E-mail do master que liberou — para saber a quem perguntar depois.
  criadoPor String
  createdAt DateTime @default(now())
}

/// Código de uso único enviado por e-mail.
///
/// Guardado como **hash**: quem lê o banco não consegue entrar na conta de
/// ninguém. Some depois de usado ou vencido.
model CodigoAcesso {
  id         String    @id @default(cuid())
  email      String
  codigoHash String
  expiraEm   DateTime
  /// Erros de digitação já feitos neste código — passou do limite, ele morre.
  tentativas Int       @default(0)
  usadoEm    DateTime?
  createdAt  DateTime  @default(now())

  @@index([email])
}

/// A carteira do Acessórias guardada entre acessos — uma única linha (id = "global").
///
/// Sem isto o cache vivia só na memória do servidor, e na Vercel cada instância
/// tem a sua: instância fria refazia a busca inteira. Agora a busca acontece nas
/// janelas de atualização (6h e 12h) ou quando alguém pede na tela.
model DiarioCarteira {
  id          String   @id
  empresas    Json
  buscadoEm   DateTime
  updatedAt   DateTime @updatedAt
}

/// Último acesso de cada pessoa, para a tela de usuários.
model AcessoUsuario {
  email     String   @id
  ultimoEm  DateTime
}
